{
  "name": "@weftai/cli",
  "version": "0.5.1",
  "description": "CLI for Weftai: run, validate, describe, trace, mcp, init.",
  "keywords": [
    "cli",
    "ai",
    "llm",
    "mcp",
    "weftai"
  ],
  "homepage": "https://github.com/tochi-mba/weftai/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tochi-mba/weftai.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tochi-mba/weftai/issues"
  },
  "license": "MIT",
  "author": "Rex Technologies",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "weftai": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@weftai/mcp": "workspace:*",
    "jiti": "^2.6.1",
    "weftai": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
