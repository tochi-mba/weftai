{
  "name": "@agentweft/anthropic",
  "version": "0.0.0",
  "description": "Expose an Agentweft runtime to Claude through the Anthropic SDK tool runner.",
  "license": "MIT",
  "author": "Tochi Mba",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "agentweft": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
