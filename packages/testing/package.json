{
  "name": "@weftai/testing",
  "version": "0.5.0",
  "description": "Test helpers for Weftai domains: runtimes, plan sugar, matchers and fixtures.",
  "keywords": [
    "testing",
    "vitest",
    "ai",
    "llm",
    "weftai"
  ],
  "homepage": "https://github.com/tochi-mba/weftai/tree/main/packages/testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tochi-mba/weftai.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/tochi-mba/weftai/issues"
  },
  "license": "MIT",
  "author": "Rex Technologies",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "import": "./dist/matchers.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "weftai": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
