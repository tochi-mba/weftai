{
  "name": "weftai",
  "version": "0.5.1",
  "description": "Composable AI workflows: declarative multi-step plans a model emits and your application validates and executes.",
  "keywords": [
    "ai",
    "llm",
    "agents",
    "tool-calling",
    "function-calling",
    "workflow",
    "declarative",
    "plans",
    "mcp"
  ],
  "homepage": "https://github.com/tochi-mba/weftai/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tochi-mba/weftai.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tochi-mba/weftai/issues"
  },
  "license": "MIT",
  "author": "Rex Technologies",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
