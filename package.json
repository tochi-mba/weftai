{
  "name": "agentweft-monorepo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "pnpm -r --parallel run clean",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
