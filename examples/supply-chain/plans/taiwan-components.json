{
  "steps": [
    {
      "id": "drone",
      "op": "parts.find",
      "input": {
        "filters": [{ "field": "label", "op": "fuzzy", "value": "Aurora Drone" }]
      }
    },
    {
      "id": "components",
      "op": "parts.components",
      "input": { "from": "$drone", "depth": "all" }
    },
    {
      "id": "taiwan",
      "op": "parts.filter",
      "input": {
        "from": "$components",
        "filters": [{ "field": "origin", "op": "eq", "value": "Taiwan" }]
      }
    }
  ]
}
